{
  "name": "@suzycss/compiler",
  "version": "0.1.3",
  "description": "Cascade FTW. A deterministic CSS theme compiler.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "bin": {
    "suzy": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/compiler.d.ts",
      "import": "./dist/core/compiler.js"
    },
    "./schema": "./suzy.schema.json"
  },
  "files": [
    "dist/core",
    "dist/cli",
    "dist/preview",
    "suzy.schema.json",
    "examples",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/assets.mjs && node scripts/schema.mjs && node scripts/executable.mjs",
    "dev": "yarn build && node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "yarn build && node --test tests/core.test.mjs tests/cli.test.mjs",
    "test:browser": "yarn build && node --test tests/browser.test.mjs",
    "prepack": "yarn build",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "biome check ."
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "modern-css-reset": "^1.4.0"
  },
  "devDependencies": {
    "@suzycss/components": "^0.1.0"
  },
  "peerDependencies": {
    "@suzycss/components": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@suzycss/components": {
      "optional": true
    }
  }
}
